## Database connection
DATABASE_URL=postgresql://user:password@localhost:5444/auth

# BetterAuth configuration
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# BetterAuth auto-migrations (optional, recommended for Kubernetes)
# If true, the server will run Better Auth migrations on startup.
# Safe for multiple replicas: guarded by a Postgres advisory lock.
BETTER_AUTH_AUTO_MIGRATE=true
# BETTER_AUTH_MIGRATION_LOCK_KEY=dream-auth:better-auth:migrations
# BETTER_AUTH_MIGRATION_LOCK_TIMEOUT_MS=600000

# Cookie configuration - optional for local development
# When not set, cookies will use the current origin (works on localhost)
# Use parent domain for cross-subdomain auth (e.g. .example.com)
# COOKIE_DOMAIN=localhost

# Headers the client IP is resolved from for rate limiting, in order; the first
# one holding a single valid address wins. Only list headers the proxy in front
# overwrites on every path. Behind a Cloudflare tunnel use the value below.
# Unset means better-auth's default, x-forwarded-for alone.
# TRUSTED_CLIENT_IP_HEADERS=cf-connecting-ip,x-forwarded-for

# Forward auth (/api/verify) authorization. The id of the ONE organization
# whose members may reach apps behind forward auth; copy it from that org's
# settings page. Per-app requirements go on the verify URL in the proxy config
# (?team=media, ?role=admin) - see docs/KUBERNETES.md. Unset = any signed-in
# user passes (legacy), with a warning at startup.
# FORWARD_AUTH_ORG_ID=

# Feature flags
ENABLE_REGISTRATION=false
ENABLE_PASSKEYS=true
ENABLE_SIWE=true
ENABLE_OIDC_PROVIDER=true

# OIDC Provider configuration
# Require PKCE for all clients (recommended for security)
OIDC_REQUIRE_PKCE=true

# OIDC Clients - JSON array of trusted client configurations
# Each client object should have:
#   - clientId: unique identifier for the client
#   - clientSecret: secret key for client authentication (required unless type=public)
#   - name: human-readable name for the consent screen
#   - redirectURLs: array of allowed redirect URIs
#   - type: "web" | "public" (etc)
#   - skipConsent: (optional) bypass consent screen for trusted clients
#   - disabled: (optional) temporarily disable a client
#   - metadata: (optional) arbitrary JSON object
#   - icon: (optional) URL string
#
# Example:
# OIDC_CLIENTS='[{"clientId":"grafana","clientSecret":"your-secret","name":"Grafana","type":"web","redirectURLs":["https://grafana.example.com/login/generic_oauth"],"skipConsent":true}]'
OIDC_CLIENTS=

# OIDC Clients (GitOps-friendly alternative)
# Path to a JSON file containing an array of client configs (e.g. mounted ConfigMap)
# Example: /config/oidc-clients.json
OIDC_CLIENTS_FILE=

# ----------------------------
# Email delivery
# ----------------------------

# "log" prints to stdout and sends nothing (default, and what local dev wants).
# "cloudflare" sends through the Cloudflare Email Sending REST API.
EMAIL_PROVIDER=log

# Sender identity. With EMAIL_PROVIDER=cloudflare, EMAIL_FROM must be on a
# domain onboarded to Cloudflare Email Sending or every send is rejected.
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=Dream Auth

# Required only when EMAIL_PROVIDER=cloudflare. The API token needs the single
# permission Account -> Email Sending -> Edit.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ----------------------------
# Client-side (Vite) variables
# ----------------------------

# Optional app title
VITE_APP_TITLE=Dream Auth

# Optional: used by better-auth client; if not set, it uses same-origin relative paths
VITE_AUTH_URL=http://localhost:3000

# WalletConnect project ID for mobile wallet support (optional)
VITE_WALLETCONNECT_PROJECT_ID=project-id-from-reown